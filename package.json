{
  "name": "@dsh-external/dsh-web-search-anysearch",
  "description": "AnySearch Web Search Provider for DeepSeek Harness: native AnySearch /v1/search, dedicated Web settings section, DSH credentials integration, Web and Headless profile support.",
  "version": "0.1.0",
  "keywords": [
    "anysearch",
    "deepseek-harness",
    "dsh-plugin",
    "web-search",
    "websearchprovider",
    "search-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcxianyujun/dsh-web-search-anysearch.git"
  },
  "homepage": "https://github.com/mcxianyujun/dsh-web-search-anysearch#readme",
  "bugs": {
    "url": "https://github.com/mcxianyujun/dsh-web-search-anysearch/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src",
    "docs",
    "scripts",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "node --test tests/*.test.mjs",
    "check": "tsdown && node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.14"
  }
}
